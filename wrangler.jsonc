{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "omuct-navi",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-06-23",
	"compatibility_flags": ["nodejs_als"],
	"workers_dev": true,
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
		"run_worker_first": false
	}
}
